<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.shakaal.collegemanagementapp.controllers.RecordFeeController"
            stylesheets="@../css/record-fee.css"
            styleClass="record-fee-root">


    <!-- ========================================================= -->
    <!-- TOP : HEADER                                               -->
    <!-- ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="form-header">

            <padding>
                <Insets top="15"
                        right="30"
                        bottom="15"
                        left="30"/>
            </padding>


            <!-- HEADER TEXT -->

            <VBox spacing="4">

                <Label text="Record Student Fee"
                       styleClass="form-title"/>

                <Label text="Record a fee payment for this student."
                       styleClass="form-subtitle"/>

            </VBox>


            <!-- PUSH LOGO TO RIGHT -->

            <Region HBox.hgrow="ALWAYS"/>


            <!-- COLLEGE LOGO -->

            <ImageView fx:id="collegeLogo"
                       fitWidth="75"
                       fitHeight="75"
                       preserveRatio="true">

                <image>
                    <Image url="@../images/Logo.png"/>
                </image>

            </ImageView>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER : MAIN FORM                                        -->
    <!-- ========================================================= -->

    <center>

        <HBox spacing="25"
              alignment="TOP_LEFT"
              styleClass="form-content">

            <padding>
                <Insets top="20"
                        right="35"
                        bottom="20"
                        left="35"/>
            </padding>


            <!-- ================================================= -->
            <!-- LEFT : STUDENT INFORMATION                        -->
            <!-- ================================================= -->

            <VBox spacing="14"
                  prefWidth="330"
                  maxWidth="330"
                  styleClass="student-info-panel">


                <!-- SECTION TITLE -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <ImageView fitWidth="30"
                               fitHeight="30"
                               preserveRatio="true">

                        <image>
                            <Image url="@../icons/information.png"/>
                        </image>

                    </ImageView>

                    <Label text="Student Information"
                           styleClass="section-title"/>

                </HBox>


                <!-- STUDENT NAME -->

                <VBox spacing="4">

                    <Label text="Student Name"
                           styleClass="field-label"/>

                    <TextField fx:id="studentNameField"
                               editable="false"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="read-only-field"/>

                </VBox>


                <!-- STUDENT ID -->

                <VBox spacing="4">

                    <Label text="Student ID"
                           styleClass="field-label"/>

                    <TextField fx:id="studentIdField"
                               editable="false"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="read-only-field"/>

                </VBox>


                <!-- COURSE -->

                <VBox spacing="4">

                    <Label text="Course"
                           styleClass="field-label"/>

                    <TextField fx:id="courseField"
                               editable="false"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="read-only-field"/>

                </VBox>


                <!-- COURSE FEE -->

                <VBox spacing="4">

                    <Label text="Course Fee"
                           styleClass="field-label"/>

                    <TextField fx:id="courseFeeField"
                               editable="false"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="read-only-field"/>

                </VBox>


            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT : PAYMENT INFORMATION                       -->
            <!-- ================================================= -->

            <VBox spacing="14"
                  prefWidth="450"
                  maxWidth="450"
                  HBox.hgrow="ALWAYS"
                  styleClass="payment-details-panel">


                <!-- SECTION TITLE -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <ImageView fitWidth="30"
                               fitHeight="30"
                               preserveRatio="true">

                        <image>
                            <Image url="@../icons/payments.png"/>
                        </image>

                    </ImageView>

                    <Label text="Payment Information"
                           styleClass="section-title"/>

                </HBox>

                <!-- ============================================= -->
                <!-- PAYMENT MONTH + PAYMENT DATE                  -->
                <!-- ============================================= -->

                <HBox spacing="12">


                    <!-- PAYMENT MONTH -->

                    <VBox spacing="4"
                          prefWidth="250"
                          maxWidth="250">

                        <Label text="Payment Month"
                               styleClass="field-label"/>

                        <ComboBox fx:id="paymentMonthComboBox"
                                  promptText="Select payment month"
                                  prefHeight="42"
                                  prefWidth="250"
                                  maxWidth="250"
                                  styleClass="form-combo"/>

                    </VBox>


                    <!-- PAYMENT DATE -->

                    <VBox spacing="4"
                          prefWidth="190"
                          maxWidth="190">

                        <Label text="Payment Date"
                               styleClass="field-label"/>

                        <TextField fx:id="paymentDateField"
                                   editable="false"
                                   prefHeight="42"
                                   prefWidth="190"
                                   maxWidth="190"
                                   styleClass="read-only-field"/>

                    </VBox>

                </HBox>


                <!-- ============================================= -->
                <!-- PAYMENT METHOD + AMOUNT                       -->
                <!-- ============================================= -->

                <HBox spacing="12">


                    <!-- PAYMENT METHOD -->

                    <VBox spacing="4"
                          prefWidth="260"
                          maxWidth="260">

                        <Label text="Payment Method"
                               styleClass="field-label"/>

                        <ComboBox fx:id="paymentMethodComboBox"
                                  promptText="Select payment method"
                                  prefHeight="42"
                                  prefWidth="260"
                                  maxWidth="260"
                                  styleClass="form-combo"/>

                    </VBox>


                    <!-- AMOUNT -->

                    <VBox spacing="4"
                          prefWidth="160"
                          maxWidth="160">

                        <Label text="Amount"
                               styleClass="field-label"/>

                        <TextField fx:id="amountField"
                                   promptText="Enter amount"
                                   prefHeight="42"
                                   prefWidth="160"
                                   maxWidth="160"
                                   styleClass="form-field"/>

                    </VBox>

                </HBox>


                <!-- ============================================= -->
                <!-- REFERENCE NUMBER                              -->
                <!-- ============================================= -->

                <VBox spacing="4">

                    <Label text="Reference Number"
                           styleClass="field-label"/>

                    <TextField fx:id="referenceNumberField"
                               editable="false"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="reference-field"/>

                </VBox>


                <!-- ============================================= -->
                <!-- NOTES                                         -->
                <!-- ============================================= -->

                <VBox spacing="4">

                    <Label text="Notes"
                           styleClass="field-label"/>

                    <TextArea fx:id="notesArea"
                              promptText="Optional payment notes"
                              prefRowCount="3"
                              prefHeight="70"
                              maxWidth="Infinity"
                              wrapText="true"
                              styleClass="form-text-area"/>

                </VBox>

            </VBox>

        </HBox>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM : ACTION BUTTONS                                   -->
    <!-- ========================================================= -->

    <bottom>

        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              styleClass="form-footer">

            <padding>
                <Insets top="12"
                        right="35"
                        bottom="20"
                        left="35"/>
            </padding>


            <!-- CANCEL -->

            <Button fx:id="cancelButton"
                    text="Cancel"
                    prefWidth="110"
                    prefHeight="42"
                    styleClass="cancel-button"/>


            <!-- RECORD PAYMENT -->

            <Button fx:id="saveButton"
                    text="Record Payment"
                    prefWidth="150"
                    prefHeight="42"
                    styleClass="save-button"/>

        </HBox>

    </bottom>

</BorderPane>