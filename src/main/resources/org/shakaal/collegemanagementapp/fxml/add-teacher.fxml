<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.layout.Region?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.shakaal.collegemanagementapp.controllers.AddTeacherController"
            stylesheets="@../css/add-teacher.css"
            styleClass="add-teacher-root">

    <!-- ========================================================= -->
    <!-- TOP : TITLE                                                -->
    <!-- ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="form-header">

            <padding>
                <Insets top="20"
                        right="30"
                        bottom="20"
                        left="30"/>
            </padding>

            <!-- HEADER TEXT -->
            <VBox spacing="4">

                <Label text="Add New Teacher"
                       styleClass="form-title"/>

                <Label text="Enter teacher information and add a profile picture."
                       styleClass="form-subtitle"/>

            </VBox>


            <!-- PUSHES LOGO TO THE RIGHT -->
            <Region HBox.hgrow="ALWAYS"/>


            <!-- COLLEGE LOGO -->
            <ImageView fx:id="collegeLogo"
                       fitWidth="85"
                       fitHeight="85"
                       preserveRatio="true">

                <image>
                    <Image url="@../images/Logo.png"/>
                </image>

            </ImageView>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER : FORM + PROFILE PICTURE                            -->
    <!-- ========================================================= -->

    <center>

        <HBox spacing="45"
              alignment="TOP_LEFT"
              styleClass="form-content">

            <padding>
                <Insets top="10"
                        right="35"
                        bottom="20"
                        left="35"/>
            </padding>


            <!-- ================================================= -->
            <!-- LEFT : TEACHER INFORMATION                         -->
            <!-- ================================================= -->

            <VBox spacing="14"
                  prefWidth="470"
                  HBox.hgrow="ALWAYS">

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <ImageView fitWidth="30"
                               fitHeight="30"
                               preserveRatio="true">

                        <image>
                            <Image url="@../icons/information.png"/>
                        </image>

                    </ImageView>

                    <Label text="Teacher Information"
                           styleClass="section-title"/>

                </HBox>


                <!-- FULL NAME -->

                <VBox spacing="4">

                    <Label text="Full Name"
                           styleClass="field-label"/>

                    <TextField fx:id="fullNameField"
                               promptText="Enter teacher full name"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="form-field"/>

                </VBox>


                <!-- GENDER + PHONE -->

                <HBox spacing="12">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Gender"
                               styleClass="field-label"/>

                        <ComboBox fx:id="genderComboBox"
                                  promptText="Select gender"
                                  prefHeight="42"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="form-combo"/>

                    </VBox>


                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Phone"
                               styleClass="field-label"/>

                        <TextField fx:id="phoneField"
                                   promptText="Enter phone number"
                                   prefHeight="42"
                                   maxWidth="Infinity"
                                   styleClass="form-field"/>

                    </VBox>

                </HBox>


                <!-- EMAIL -->

                <VBox spacing="4">

                    <Label text="Email"
                           styleClass="field-label"/>

                    <TextField fx:id="emailField"
                               promptText="Enter email address"
                               prefHeight="42"
                               maxWidth="Infinity"
                               styleClass="form-field"/>

                </VBox>


                <!-- SPECIALIZATION + SALARY -->

                <HBox spacing="12">

                    <!-- SPECIALIZATION -->

                    <VBox spacing="4"
                          prefWidth="300"
                          HBox.hgrow="ALWAYS">

                        <Label text="Specialization"
                               styleClass="field-label"/>

                        <TextField fx:id="specializationField"
                                   promptText="Enter specialization"
                                   prefHeight="46"
                                   maxWidth="Infinity"
                                   styleClass="form-field"/>

                    </VBox>


                    <!-- SALARY -->

                    <VBox spacing="4"
                          prefWidth="140">

                        <Label text="Salary"
                               styleClass="field-label"/>

                        <TextField fx:id="salaryField"
                                   promptText="Enter salary"
                                   prefHeight="46"
                                   maxWidth="Infinity"
                                   styleClass="form-field"/>

                    </VBox>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT : PROFILE PICTURE                            -->
            <!-- ================================================= -->

            <VBox spacing="15"
                  alignment="TOP_CENTER"
                  prefWidth="300"
                  styleClass="picture-section">

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <ImageView fitWidth="24"
                               fitHeight="24"
                               preserveRatio="true">

                        <image>
                            <Image url="@../icons/Image.png"/>
                        </image>

                    </ImageView>

                    <Label text="Profile Picture"
                           styleClass="section-title"/>

                </HBox>


                <!-- IMAGE PREVIEW -->

                <StackPane fx:id="imagePreviewContainer"
                           prefWidth="220"
                           prefHeight="220"
                           maxWidth="220"
                           maxHeight="220"
                           styleClass="image-preview-container">

                    <ImageView fx:id="profileImageView"
                               fitWidth="210"
                               fitHeight="210"
                               preserveRatio="true"/>

                    <VBox fx:id="picturePlaceholder"
                          alignment="CENTER"
                          spacing="8">

                        <Label text="📷"
                               styleClass="picture-placeholder-icon"/>

                        <Label text="No picture selected"
                               styleClass="picture-placeholder-text"/>

                    </VBox>

                </StackPane>


                <!-- CHOOSE PICTURE -->

                <Button fx:id="choosePictureButton"
                        text="Choose Picture"
                        prefWidth="300"
                        prefHeight="45"
                        graphicTextGap="10"
                        maxWidth="Infinity"
                        styleClass="choose-picture-button">

                    <graphic>

                        <ImageView fitWidth="20"
                                   fitHeight="20"
                                   preserveRatio="true">

                            <image>
                                <Image url="@../icons/chooseImage.png"/>
                            </image>

                        </ImageView>

                    </graphic>

                </Button>


                <!-- REMOVE PICTURE -->

                <Button fx:id="removePictureButton"
                        text="Remove Picture"
                        prefWidth="300"
                        prefHeight="45"
                        graphicTextGap="10"
                        maxWidth="Infinity"
                        styleClass="remove-picture-button">

                    <graphic>

                        <ImageView fitWidth="20"
                                   fitHeight="20"
                                   preserveRatio="true">

                            <image>
                                <Image url="@../icons/bin.png"/>
                            </image>

                        </ImageView>

                    </graphic>

                </Button>

                <!-- SELECTED FILE -->

                <Label fx:id="pictureFileNameLabel"
                       text="No picture selected"
                       wrapText="true"
                       maxWidth="250"
                       alignment="CENTER"
                       styleClass="picture-file-label"/>

            </VBox>

        </HBox>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM : ACTION BUTTONS                                   -->
    <!-- ========================================================= -->

    <bottom>

        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              styleClass="form-footer">

            <padding>
                <Insets top="15"
                        right="35"
                        bottom="25"
                        left="35"/>
            </padding>

            <Button fx:id="cancelButton"
                    text="Cancel"
                    prefWidth="110"
                    prefHeight="42"
                    styleClass="cancel-button"/>

            <Button fx:id="saveTeacherButton"
                    text="Save Teacher"
                    prefWidth="150"
                    prefHeight="42"
                    styleClass="save-button"/>

        </HBox>

    </bottom>

</BorderPane>