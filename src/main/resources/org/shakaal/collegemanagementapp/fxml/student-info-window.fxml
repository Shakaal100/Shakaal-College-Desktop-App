<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.shakaal.collegemanagementapp.controllers.StudentInfoController"
            stylesheets="@../css/student-info.css"
            styleClass="student-info-root"
            prefWidth="850"
            prefHeight="650">
    <!-- ========================================================= -->
    <!-- TOP : HEADER                                              -->
    <!-- ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="info-header">

            <padding>
                <Insets top="18"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <!-- HEADER TEXT -->

            <VBox spacing="4">

                <Label text="Student Information"
                       styleClass="info-title"/>

                <Label text="View student details and profile information."
                       styleClass="info-subtitle"/>

            </VBox>


            <!-- PUSHES LOGO TO THE FAR RIGHT -->

            <Region HBox.hgrow="ALWAYS"/>


            <!-- COLLEGE LOGO -->

            <ImageView fx:id="collegeLogo"
                       fitWidth="120"
                       fitHeight="120"
                       preserveRatio="true"
                       smooth="true">

                <image>
                    <Image url="@../images/Logo.png"/>
                </image>

            </ImageView>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER : PROFILE + INFORMATION                            -->
    <!-- ========================================================= -->

    <center>
        <HBox spacing="35"
              alignment="TOP_LEFT"
              minHeight="0"
              styleClass="info-content">

            <padding>
                <Insets top="25"
                        right="35"
                        bottom="20"
                        left="35"/>
            </padding>

            <!-- ========================================================= -->
            <!-- LEFT : STUDENT PROFILE                                   -->
            <!-- ========================================================= -->

            <VBox spacing="14"
                  alignment="TOP_CENTER"
                  prefWidth="270"
                  styleClass="profile-section">

                <!-- PROFILE IMAGE -->

                <StackPane fx:id="imagePreviewContainer"
                           prefWidth="220"
                           prefHeight="220"
                           minWidth="220"
                           minHeight="220"
                           maxWidth="220"
                           maxHeight="220"
                           alignment="CENTER"
                           styleClass="image-preview-container">

                    <ImageView fx:id="profileImageView"
                               fitWidth="210"
                               fitHeight="210"
                               preserveRatio="true"
                               smooth="true"/>

                </StackPane>


                <!-- STUDENT NAME -->

                <Label fx:id="studentNameLabel"
                       text="Student Name"
                       styleClass="profile-name"/>


                <!-- STUDENT ID -->

                <Label fx:id="studentIdLabel"
                       text="Student ID: 0"
                       styleClass="profile-id"/>


                <!-- STATUS -->

                <Label fx:id="statusLabel"
                       text="Active"
                       styleClass="status-label"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT : STUDENT INFORMATION                        -->
            <!-- ================================================= -->

            <VBox spacing="20"
                  HBox.hgrow="ALWAYS"
                  prefWidth="480">


                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION                              -->
                <!-- ================================================= -->

                <VBox spacing="10"
                      styleClass="information-section">

                    <Label text="Personal Information"
                           styleClass="section-title"/>

                    <VBox spacing="8"
                          styleClass="details-card">

                        <!-- FULL NAME -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Full Name"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="fullNameLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>


                        <!-- GENDER -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Gender"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="genderLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>


                <!-- ================================================= -->
                <!-- CONTACT INFORMATION                               -->
                <!-- ================================================= -->

                <VBox spacing="10"
                      styleClass="information-section">

                    <Label text="Contact Information"
                           styleClass="section-title"/>

                    <VBox spacing="8"
                          styleClass="details-card">

                        <!-- PHONE -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Phone"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="phoneLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>


                        <!-- EMAIL -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Email"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="emailLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>


                        <!-- ADDRESS -->

                        <HBox spacing="15"
                              alignment="TOP_LEFT">

                            <Label text="Address"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="addressLabel"
                                   text="—"
                                   wrapText="true"
                                   maxWidth="300"
                                   styleClass="detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>


                <!-- ================================================= -->
                <!-- ACADEMIC INFORMATION                              -->
                <!-- ================================================= -->

                <VBox spacing="10"
                      styleClass="information-section">

                    <Label text="Academic Information"
                           styleClass="section-title"/>

                    <VBox spacing="8"
                          styleClass="details-card">

                        <!-- COURSE -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Course"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="courseLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>


                        <!-- REGISTERED DATE -->

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Registered"
                                   styleClass="detail-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="registeredDateLabel"
                                   text="—"
                                   styleClass="detail-value"/>

                        </HBox>

                    </VBox>

                </VBox>

            </VBox>

        </HBox>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM : CLOSE BUTTON                                     -->
    <!-- ========================================================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="10"
              styleClass="info-footer">

            <padding>
                <Insets top="15"
                        right="35"
                        bottom="25"
                        left="35"/>
            </padding>

            <Button fx:id="closeButton"
                    text="Close"
                    prefWidth="110"
                    prefHeight="42"
                    styleClass="close-button"/>

        </HBox>

    </bottom>

</BorderPane>
