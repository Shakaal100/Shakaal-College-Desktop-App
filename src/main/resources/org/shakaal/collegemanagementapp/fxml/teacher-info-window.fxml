<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.shakaal.collegemanagementapp.controllers.TeacherInfoController"
            stylesheets="@../css/teacher-info.css"
            styleClass="teacher-info-root"
            prefWidth="850"
            prefHeight="650">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <top>

        <HBox styleClass="info-header"
              alignment="CENTER_LEFT"
              spacing="15">

            <padding>
                <Insets top="18"
                        right="25"
                        bottom="18"
                        left="25"/>
            </padding>

            <VBox spacing="3">

                <Label text="Teacher Information"
                       styleClass="info-title"/>

                <Label text="View teacher profile and professional details"
                       styleClass="info-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- COLLEGE LOGO -->

            <ImageView fx:id="collegeLogo"
                       fitWidth="110"
                       fitHeight="110"
                       preserveRatio="true">

                <Image url="@../images/Logo.png"/>

            </ImageView>

        </HBox>

    </top>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <HBox spacing="25"
              alignment="TOP_LEFT"
              minHeight="0"
              styleClass="info-content">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>


            <!-- =================================================
                 LEFT PROFILE CARD
                 ================================================= -->

            <VBox styleClass="profile-section"
                  alignment="TOP_CENTER"
                  spacing="10"
                  prefWidth="250"
                  minWidth="250"
                  maxWidth="250">


                <!-- IMAGE -->

                <StackPane styleClass="image-preview-container"
                           prefWidth="220"
                           prefHeight="220"
                           minWidth="220"
                           minHeight="220"
                           maxWidth="220"
                           maxHeight="220">

                    <ImageView fx:id="profileImageView"
                               fitWidth="210"
                               fitHeight="210"
                               preserveRatio="true"/>

                </StackPane>


                <!-- TEACHER NAME -->

                <Label fx:id="teacherNameLabel"
                       text="Teacher Name"
                       styleClass="profile-name"
                       wrapText="true"/>


                <!-- TEACHER ID -->

                <Label fx:id="teacherIdLabel"
                       text="Teacher ID: 0"
                       styleClass="profile-id"/>


                <!-- STATUS -->

                <Label fx:id="statusLabel"
                       text="Active"
                       styleClass="status-label"/>

            </VBox>


            <!-- =================================================
                 RIGHT INFORMATION AREA
                 ================================================= -->

            <VBox styleClass="information-section"
                  spacing="12"
                  HBox.hgrow="ALWAYS">


                <!-- ================= PERSONAL ================= -->

                <Label text="Personal Information"
                       styleClass="section-title"/>

                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Full Name"
                           styleClass="detail-label"/>

                    <Label fx:id="fullNameLabel"
                           text="—"
                           styleClass="detail-value"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>

                </HBox>


                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Gender"
                           styleClass="detail-label"/>

                    <Label fx:id="genderLabel"
                           text="—"
                           styleClass="detail-value"
                           HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- ================= CONTACT ================= -->

                <Label text="Contact Information"
                       styleClass="section-title"/>

                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Phone"
                           styleClass="detail-label"/>

                    <Label fx:id="phoneLabel"
                           text="—"
                           styleClass="detail-value"
                           HBox.hgrow="ALWAYS"/>

                </HBox>


                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Email"
                           styleClass="detail-label"/>

                    <Label fx:id="emailLabel"
                           text="—"
                           styleClass="detail-value"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- ================= PROFESSIONAL ================= -->

                <Label text="Professional Information"
                       styleClass="section-title"/>

                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Specialization"
                           styleClass="detail-label"/>

                    <Label fx:id="specializationLabel"
                           text="—"
                           styleClass="detail-value"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>

                </HBox>


                <HBox styleClass="details-card"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Salary"
                           styleClass="detail-label"/>

                    <Label fx:id="salaryLabel"
                           text="—"
                           styleClass="detail-value"
                           HBox.hgrow="ALWAYS"/>

                </HBox>

            </VBox>

        </HBox>

    </center>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <bottom>

        <HBox styleClass="info-footer"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="12"
                        right="25"
                        bottom="12"
                        left="25"/>
            </padding>

            <Button fx:id="closeButton"
                    text="Close"
                    styleClass="close-button"
                    prefWidth="90"
                    prefHeight="34"/>

        </HBox>

    </bottom>

</BorderPane>